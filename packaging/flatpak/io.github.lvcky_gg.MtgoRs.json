{
  "app-id": "io.github.lvcky_gg.MtgoRs",
  "default-branch": "stable",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "mtg-gui",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--talk-name=org.freedesktop.Flatpak",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "mtgo-rs",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {"CARGO_NET_OFFLINE": "true",
          "MTGO_RS_RELEASE_PLATFORM": "linux-x64-flatpak"}
      },
      "build-commands": [
        "cargo build --offline --frozen --release -p mtg-app --bin mtg-gui",
        "install -Dm755 target/release/mtg-gui /app/bin/mtg-gui",
        "install -Dm644 packaging/flatpak/io.github.lvcky_gg.MtgoRs.desktop /app/share/applications/io.github.lvcky_gg.MtgoRs.desktop",
        "install -Dm644 packaging/flatpak/io.github.lvcky_gg.MtgoRs.metainfo.xml /app/share/metainfo/io.github.lvcky_gg.MtgoRs.metainfo.xml",
        "install -Dm644 packaging/flatpak/io.github.lvcky_gg.MtgoRs.svg /app/share/icons/hicolor/scalable/apps/io.github.lvcky_gg.MtgoRs.svg"
      ],
      "sources": [{"type": "archive", "path": "../../dist/flatpak-source.tar.gz", "strip-components": 0}]
    }
  ]
}
